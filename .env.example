# Target application to monitor
TARGET_NAME=Empty Classroom Finder
TARGET_URL=https://empty-classroom-finder.onrender.com

# Monitoring frequency in seconds (minimum 10)
CHECK_INTERVAL_SECONDS=60

# Optional: GitHub repository in owner/repo format for GitHub Actions monitoring
GITHUB_REPO=

# Optional: GitHub personal access token for private repos or higher API rate limits
GITHUB_TOKEN=

# Optional: Slack/Discord/generic webhook URL for downtime & recovery notifications
ALERT_WEBHOOK_URL=

# Optional: SQLite database file path
DB_PATH=monitoring.db
